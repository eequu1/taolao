<% content_for :title, @visit.place.name %>
<% user = current_user %>

<div class="container visit-summary my-4">
  <h2 class="mb-3"><%= @visit.place.name %></h2>

  <% if @visit.reviewed? %>
    <% if flash[:levels_gained].to_i.positive? %>
      <div class="level-up alert alert-warning text-center fs-4">
        <i class="fa-solid fa-star"></i> You reached level <%= user.level %>!
      </div>
    <% end %>

    <div class="xp-card mb-4">
      <div class="xp-earned">+<%= @visit.experience_awarded %> XP</div>
      <% phrase_xp = @visit.phrase_experience(@visit.phrases.prepped.where(used: true).count) %>
      <div class="small text-muted">
        Going there: <%= @visit.experience_awarded - phrase_xp %> XP
        · Phrases you used: <%= phrase_xp %> XP
      </div>

      <div class="mt-3 d-flex justify-content-between">
        <strong>Level <%= user.level %></strong>
        <% if user.experience_for_next_level %>
          <span class="small"><%= user.experience_into_level %> / <%= user.experience_for_next_level %> XP</span>
        <% else %>
          <span class="small">Max level!</span>
        <% end %>
      </div>
      <% percent = user.experience_for_next_level ? 100 * user.experience_into_level / user.experience_for_next_level : 100 %>
      <div class="progress" role="progressbar" aria-label="Progress to next level"
           aria-valuenow="<%= percent %>" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-bar bg-warning" style="width: <%= percent %>%"></div>
      </div>
    </div>

    <% used = @visit.phrases.prepped.where(used: true) %>
    <% if used.any? %>
      <h4>Phrases you used</h4>
      <% used.each do |phrase| %>
        <div class="phrase-card">
          <div class="phrase-text">
            <div class="japanese"><%= phrase.japanese %></div>
            <div class="romaji"><%= phrase.romaji %></div>
            <div class="english"><%= phrase.english %></div>
          </div>
        </div>
      <% end %>
    <% end %>

    <section id="heard" class="heard-section my-4">
      <h4>Anything you heard but didn't understand?</h4>
      <% heard = @visit.phrases.where(source: [:heard, :manual]).order(:created_at) %>
      <div id="heard-phrases">
        <% if heard.none? %>
          <p id="no-heard-phrases" class="text-muted">Nothing added yet.</p>
        <% end %>
        <%= render partial: "phrases/phrase", collection: heard, as: :phrase %>
      </div>
      <%= render "phrases/form", visit: @visit, phrase: Phrase.new %>
    </section>

    <%= link_to "Find another place", places_path, class: "btn btn-warning w-100 my-3" %>
  <% else %>
    <p>Been there already? Tell us how it went to earn XP.</p>
    <%= link_to "Review my visit", review_visit_path(@visit), class: "btn btn-warning btn-lg w-100" %>
  <% end %>
</div>
