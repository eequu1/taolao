<%# A 1–5 tap scale. Locals: f (form builder), field, question, low, high %>
<fieldset class="rating-scale mb-4">
  <legend class="fs-5"><%= question %></legend>
  <div class="btn-group w-100" role="group">
    <% (1..5).each do |value| %>
      <%= f.radio_button field, value, class: "btn-check", id: "#{field}_#{value}" %>
      <%= f.label field, value.to_s, value: value, for: "#{field}_#{value}", class: "btn btn-outline-warning" %>
    <% end %>
  </div>
  <div class="d-flex justify-content-between small text-muted mt-1">
    <span><%= low %></span>
    <span><%= high %></span>
  </div>
  <% if @visit.errors[field].any? %>
    <div class="text-danger small">Please choose a number from 1 to 5.</div>
  <% end %>
</fieldset>
