<div class="orange-session">
  <%= image_tag @place.image_url, alt: @place.name, class: "place-image" %>
  <div class="info">
    <div class="text-center">
      <h1> <%= @place.name %> </h1>
      <p> <%= @place.description %> </p>
    </div>
  </div>
</div>
<div class="container">
  <div class="key-phrase">
    <%# prepped only: phrases users heard after a visit are private to them %>
    <% @place.phrases.prepped.each do |phrase|%>
      <div class="phrase-card">
        <div class="phrase-text">
          <div class="japanese"> <%= phrase.japanese %></div>
          <div class="romaji"><%= phrase.romaji %></div>
          <div class="english"><%= phrase.english %></div>
        </div>
        <div
          class="play-btn"
          data-controller="tts"
          data-tts-text-value="<%= phrase.japanese %>"
          data-tts-url-value="<%= speak_place_path(@place) %>"
          data-action="click->tts#play"
          style="cursor: pointer;">
          <i class="fa-regular fa-circle-play"></i>
        </div>
      </div>
    <% end %>
  </div>
  <div class="d-flex justify-content-center">
    <%= button_to "Let's go!", place_visits_path(@place), class:"btn start-btn" %>
  </div>
  <% if @my_phrases.any? %>
    <h2 class="mt-4">Your phrases</h2>
    <p class="text-muted">Phrases you added on your visits here. Only you can see these.</p>
    <div class="place-phrases">
      <%= render partial: "places/phrase_card", collection: @my_phrases, as: :phrase, locals: { place: @place } %>
    </div>
  <% end %>
  <%# Phrases generated in the background arrive here from PlacePhrasesJob %>
  <%= turbo_stream_from @place, :phrases %>
  <%= render "places/phrases", place: @place, generating: @generating_phrases %>
</div>
