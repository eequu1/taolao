<div class="container">
  <div class="backdrop">
    <%= image_tag @place.image_url, alt: @place.name, class: "place-image" %>
    <div class="info">
      <div class="text-center">
        <h4> <%= @place.name %></h4>
        <p> <%= @place.description %></p>
      </div>
      <span class="badge rounded-pill text-bg-warning"> Minimum Level:<%= @place.minimum_level %></span>
    </div>
  </div>
  <%= button_to "Create a Visit", place_visits_path(@place), class:"btn btn-primary my-2 mb-4" %>
  <h2>Key phrases</h2>
  <p class="text-muted">A conversation from walking in to leaving, for ordering here.</p>
  <%# Phrases generated in the background arrive here from PlacePhrasesJob %>
  <%= turbo_stream_from @place, :phrases %>
  <%= render "places/phrases", place: @place, generating: @generating_phrases %>
</div>
