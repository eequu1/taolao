<div class="container my-4">
  <div id="map"
    data-controller="google-maps"
    data-google-maps-markers-value="<%= @markers.to_json %>"
    style="width: 100%; height: 600px; border-radius: 8px;">
  </div>

  <h4>Locations</h4>
  <div class="row">
    <%= render partial: "places/map_box", collection: @places, as: :place %>
  </div>
</div>
