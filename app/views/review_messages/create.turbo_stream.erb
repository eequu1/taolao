<%# AiMessageJob broadcasts the reply and removes the typing bubble %>
<%= turbo_stream.append "chat-messages", partial: "review_messages/message", locals: { message: @user_message } %>
<%= turbo_stream.append "chat-messages", partial: "review_messages/typing" %>
<%= turbo_stream.replace "chat-form", partial: "review_messages/form", locals: { visit: @visit } %>
