<%# Manual entry for a phrase that isn't in the suggestions. Locals: visit, phrase %>
<%= simple_form_for [visit, phrase], html: { id: "manual-phrase-form", class: "manual-phrase-form" } do |f| %>
  <% if phrase.errors.any? %>
    <div class="text-danger small mb-2"><%= phrase.errors.full_messages.to_sentence %></div>
  <% end %>
  <p class="small text-muted mb-2">Not in the list? Write down whatever you caught. One field is enough.</p>
  <%= f.input :japanese, label: false, placeholder: "Japanese (e.g. 温めますか？)" %>
  <%= f.input :romaji, label: false, placeholder: "Romaji (e.g. atatamemasu ka)" %>
  <%= f.input :english, label: false, placeholder: "What you think it meant" %>
  <%= f.button :submit, "Add phrase", class: "btn btn-outline-warning w-100" %>
<% end %>
